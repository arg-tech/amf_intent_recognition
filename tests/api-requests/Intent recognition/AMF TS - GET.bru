meta {
  name: AMF TS - GET
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/amf_ts
  auth: inherit
}

tests {
  test("Response status should be 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Response should return HTML page", function () {
    const body = res.getBody();
    expect(body).to.include("Intentifier");
  });
}
