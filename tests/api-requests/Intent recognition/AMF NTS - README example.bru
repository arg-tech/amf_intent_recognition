meta {
  name: AMF NTS - README example
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/amf_nts
  body: multipartForm
  auth: inherit
}

headers {
  Content-Type: multipart/form-data
}

body:multipart-form {
  file: @file(test-inputs/xaif_readme_example.json)
}

tests {
  const validIntents = [
    "Agreeing",
    "Arguing",
    "Asserting",
    "Assertive Questioning",
    "Challenging",
    "Default Illocuting",
    "Disagreeing",
    "Pure Questioning",
    "Restating",
    "Rhetorical Questioning"
  ];

  test("Response status should be 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Response should contain AIF structure", function () {
    const body = res.getBody();
    expect(body).to.have.property("AIF");
    expect(body.AIF).to.have.property("nodes");
    expect(body.AIF).to.have.property("edges");
    expect(body.AIF).to.have.property("locutions");
    expect(body.AIF).to.have.property("participants");
  });

  test("All 3 YA nodes should be classified with valid intents", function () {
    const body = res.getBody();
    const yaNodes = body.AIF.nodes.filter(n => n.type === "YA");
    expect(yaNodes.length).to.equal(3);
    yaNodes.forEach(node => {
      expect(validIntents).to.include(node.text);
    });
  });

  test("All 3 L nodes should be preserved", function () {
    const body = res.getBody();
    const lNodes = body.AIF.nodes.filter(n => n.type === "L");
    expect(lNodes.length).to.equal(3);
  });

  test("Edges should be preserved", function () {
    const body = res.getBody();
    expect(body.AIF.edges.length).to.be.greaterThan(0);
  });

  test("No timestamps should be present on nodes (NTS variant)", function () {
    const body = res.getBody();
    body.AIF.nodes.forEach(node => {
      expect(node).to.not.have.property("timestamp");
    });
  });

  test("No scheme/schemeID should be present on nodes", function () {
    const body = res.getBody();
    body.AIF.nodes.forEach(node => {
      expect(node).to.not.have.property("scheme");
      expect(node).to.not.have.property("schemeID");
    });
  });
}
